#####USING GROUPED VARIABLES######
#Calculate the mean of all the questions forming a Group, and create new
    #variable Group_.. with the mean
Group_06 <- rowMeans(impdata[c("g06f", "g06e")], na.rm = TRUE)
Group_07 <- rowMeans(impdata[c("g07d")], na.rm = TRUE)
Group_08 <- rowMeans(impdata[c("g08c")], na.rm = TRUE)
Group_09 <- rowMeans(impdata[c("g09a", "g09c", "g09d")], na.rm = TRUE)
Group_13 <- rowMeans(impdata[c("g13a", "g13j")], na.rm = TRUE)
Group_14 <- rowMeans(impdata[c("g14a", "g14b", "g14d")], na.rm = TRUE)
Group_15 <- rowMeans(impdata[c("g15a", "g15g", "g15i", "g15l")], na.rm = TRUE)
Group_16 <- rowMeans(impdata[c("g16b")], na.rm = TRUE)
grouped_means <- data.frame(
  Group_06 = Group_06,
  Group_07 = Group_07,
  Group_08 = Group_08,
  Group_09 = Group_09,
  Group_13 = Group_13,
  Group_14 = Group_14,
  Group_15 = Group_15,
  Group_16 = Group_16
)
grouped_means <- cbind(g27a = impdata$g27a, grouped_means)
head(grouped_means)
groupR<-cor(grouped_means)
png("groupcorr.png",width=800, height=600)
corrplot(
groupR,
method = "color",
type = "upper",
addCoef.col = "black",
number.cex = 1,
tl.col = "black",
tl.srt = 45,
tl.cex = 1.2, s
col = colorRampPalette(c("lightblue", "white", "darkorange"))(200), mar = c(0, 0, 2, 0)
) dev.off()
